{
  "name": "@aiengineer/database-contract",
  "version": "0.1.0",
  "private": true,
  "description": "Canonical Supabase migrations and generated TypeScript database contract for AI Engineer systems.",
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./api": {
      "types": "./src/api.ts",
      "default": "./src/api.ts"
    },
    "./pre-research": {
      "types": "./src/pre-research.ts",
      "default": "./src/pre-research.ts"
    }
  },
  "files": [
    "src",
    "supabase/migrations",
    "supabase/config.toml",
    "supabase/seed.sql"
  ],
  "scripts": {
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "types:generate": "node scripts/generate-types.mjs --local",
    "types:check": "node scripts/generate-types.mjs --local --check",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "supabase": "2.115.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
