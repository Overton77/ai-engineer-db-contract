{
  "name": "@aiengineer/database-contract",
  "version": "0.3.0",
  "private": true,
  "description": "Canonical Supabase migrations and generated TypeScript database contract for AI Engineer systems.",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./api": {
      "types": "./src/api.ts",
      "default": "./src/api.ts"
    },
    "./pre-research": {
      "types": "./src/pre-research.ts",
      "default": "./src/pre-research.ts"
    },
    "./provenance": {
      "types": "./src/provenance.ts",
      "default": "./src/provenance.ts"
    }
  },
  "files": [
    "src",
    "supabase/migrations",
    "supabase/config.toml",
    "supabase/seed.sql"
  ],
  "scripts": {
    "db:start": "supabase start",
    "db:migrate": "supabase migration up --local",
    "db:reset": "node scripts/reset-disposable-local.mjs",
    "types:generate": "node scripts/generate-types.mjs --local",
    "types:check": "node scripts/generate-types.mjs --local --check",
    "types:generate:native": "node scripts/generate-types.mjs --local-node",
    "types:check:native": "node scripts/generate-types.mjs --local-node --check",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@supabase/postgres-meta": "0.95.2",
    "supabase": "2.115.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}

